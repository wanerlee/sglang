{
  "version": 1,
  "cache_ratio": 0.25,
  "offline_stats_path": "/path/to/deepseek-v4-expert-profile.json",
  "offline_model_id": "DeepSeek-V4-Flash",
  "update_interval": 4,
  "min_usage": 2.0,
  "replacement_min_gain": 1.5,
  "max_swaps": 96,
  "usage_decay": 0.7,
  "execution_slots": 16,
  "host_pool_gib": 128,
  "workspace_limit_bytes": 8589934592,
  "metadata_limit_bytes": 1073741824,
  "max_dispatch_rows": 32768,
  "batch_log_interval": 1,
  "batch_log_capacity": 64,
  "native_extension_directory": "/tmp/sglang-moe-acl"
}
